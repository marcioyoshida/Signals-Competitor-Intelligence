{
  "expo": {
    "name": "Onça",
    "slug": "onca",
    "scheme": "onca",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0e1214",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.onssa.onca",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "WKAppBoundDomains": [
          "onssa.org",
          "www.onssa.org"
        ]
      }
    },
    "android": {
      "package": "org.onssa.onca",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0e1214"
      }
    },
    "plugins": [
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#3ec39a",
          "defaultChannel": "alerts"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O Onça usa o Face ID para desbloquear o app quando você ativa o bloqueio."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "63b7da8b-7d85-44f9-b784-249a79c47131"
      }
    },
    "owner": "marcioy"
  }
}
