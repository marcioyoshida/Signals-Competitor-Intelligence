    "additionalProperties": false
   }
  },
  "headers": {
   "AuditId": {
    "description": "This request's audit id. For /v1/check and /v1/entities/{id} it is the id of the answer's audit record. For /v1/screen, each answered query has its own record, whose id is that result's audit_id. A record holds the query (for /v1/entities/{id}, as the equivalent entity_id and jurisdiction query), a hash of the API key, the answer as served with its SHA-256, and the snapshot ids it cites. An answer too large for one log event is recorded by its SHA-256 and snapshot ids only. Records are written off the response path, and a failed write does not fail the lookup. Error responses are not recorded.",
    "schema": {
     "type": "string"
    }
   }
  }
