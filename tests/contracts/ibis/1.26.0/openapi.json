   "ScreenRequest": {
    "type": "object",
    "properties": {
     "queries": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Query"
      },
      "minItems": 1,
      "maxItems": 100
     }
    },
    "required": [
     "queries"
    ]
   },
   "ScreenResult": {
    "oneOf": [
     {
      "type": "object",
      "properties": {
       "status": {
        "const": 200
       },
       "answer": {
        "$ref": "Answer.schema.json"
       },
       "audit_id": {
        "type": "string",
        "description": "The id of this answer's audit record: the x-ibis-audit-id header value, a hyphen, and the query's 0-based index in the request. Results with an error have no audit record."
       }
      },
      "required": [
       "status",
       "answer",
       "audit_id"
      ],
      "additionalProperties": false
     },
     {
      "type": "object",
